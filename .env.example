# ============================================================
# EVOTRADE-AI — Environment Variables Template
# Copy this to .env and fill in your real values
# ============================================================

# --- MT5 Demo (Paper Trading) Account ---
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=

# --- MT5 Live Account ---
MT5_LIVE_LOGIN=
MT5_LIVE_PASSWORD=
MT5_LIVE_SERVER=

# --- Active Mode: "paper" or "live" ---
TRADING_MODE=paper

# --- FastAPI Backend ---
API_SECRET_KEY=
API_HOST=127.0.0.1
API_PORT=8000

# --- Database ---
DATABASE_URL=postgresql://aibot:aibot@localhost:5432/aibot_mt5


