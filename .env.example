# ============================================================
# EVOTRADE-AI — Environment Variables Template
# Copy this to .env and fill in your real values
#
# SECURITY: This file is excluded from git (.gitignore)
#           NEVER commit .env files to version control
# ============================================================

# --- MT5 Demo (Paper Trading) Account ---
# Get credentials from XM: https://www.xm.com/mt5
# After creating demo account, find login/password in MT5 terminal
MT5_DEMO_LOGIN=1301109267
MT5_DEMO_PASSWORD=YourDemoPasswordHere
MT5_DEMO_SERVER=XMGlobal-MT5 6

# --- MT5 Live Account ---
# WARNING: Live trading uses real money!
# Only enable after profitability validation passes (50% WR, 1.5 PF)
MT5_LIVE_LOGIN=420033339
MT5_LIVE_PASSWORD=YourLivePasswordHere
MT5_LIVE_SERVER=XMGlobal-MT5 18

# --- Active Mode: "paper" or "live" ---
# Use "paper" for demo account testing
# Use "live" only after validation (currently: 21.88% WR ❌)
TRADING_MODE=paper

# --- FastAPI Backend ---
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=generate-random-32-char-secret-key-here
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (for future multi-user features) ---
# Currently unused, will be required for Task #17-19
DATABASE_URL=postgresql://aibot:aibot@localhost:5432/aibot_mt5


