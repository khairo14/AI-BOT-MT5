groups:
  - name: aibot_system_alerts
    interval: 30s
    rules:
      - alert: HighCPU
        expr: aibot_cpu_usage_percent > 80
        for: 5m
        labels:
          severity: warning
          component: system
        annotations:
          summary: "High CPU usage on {{ $labels.instance }}"
          description: "CPU usage is {{ $value }}% (threshold: 80%)"
          
      - alert: CriticalCPU
        expr: aibot_cpu_usage_percent > 95
        for: 2m
        labels:
          severity: critical
          component: system
        annotations:
          summary: "CRITICAL CPU usage on {{ $labels.instance }}"
          description: "CPU usage is {{ $value }}% (threshold: 95%)"
          
      - alert: HighMemory
        expr: aibot_memory_usage_percent > 90
        for: 5m
        labels:
          severity: warning
          component: system
        annotations:
          summary: "High memory usage on {{ $labels.instance }}"
          description: "Memory usage is {{ $value }}% (threshold: 90%)"
          
      - alert: DiskSpaceLow
        expr: aibot_disk_usage_percent > 85
        for: 10m
        labels:
          severity: warning
          component: system
        annotations:
          summary: "Low disk space on {{ $labels.instance }}"
          description: "Disk usage is {{ $value }}% (threshold: 85%)"


  - name: aibot_mt5_alerts
    interval: 30s
    rules:
      - alert: MT5Disconnected
        expr: aibot_mt5_connected == 0
        for: 1m
        labels:
          severity: critical
          component: mt5
        annotations:
          summary: "MT5 connection lost on {{ $labels.instance }}"
          description: "MT5 has been disconnected for over 1 minute"
          
      - alert: NoTradesToday
        expr: aibot_trades_today == 0 and hour() > 10 and hour() < 20
        for: 4h
        labels:
          severity: warning
          component: trading
        annotations:
          summary: "No trades executed today on {{ $labels.instance }}"
          description: "Zero trades during active market hours (10:00-20:00 UTC)"
          
      - alert: SignalQueueBacklog
        expr: aibot_signal_queue_size > 50
        for: 5m
        labels:
          severity: warning
          component: trading
        annotations:
          summary: "Signal queue backlog on {{ $labels.instance }}"
          description: "{{ $value }} signals pending (threshold: 50)"


  - name: aibot_api_alerts
    interval: 30s
    rules:
      - alert: HighErrorRate
        expr: rate(aibot_api_errors_total[5m]) > 0.05
        for: 2m
        labels:
          severity: warning
          component: api
        annotations:
          summary: "High API error rate on {{ $labels.instance }}"
          description: "Error rate: {{ $value | humanizePercentage }} (threshold: 5%)"
          
      - alert: HighLatency
        expr: aibot_api_latency_ms > 500
        for: 3m
        labels:
          severity: warning
          component: api
        annotations:
          summary: "High API latency on {{ $labels.instance }}"
          description: "Endpoint {{ $labels.endpoint }} latency: {{ $value }}ms (threshold: 500ms)"


  - name: aibot_trading_alerts
    interval: 60s
    rules:
      - alert: HighDrawdown
        expr: aibot_unrealized_pnl < -1000
        for: 10m
        labels:
          severity: warning
          component: trading
        annotations:
          summary: "High unrealized drawdown on {{ $labels.instance }}"
          description: "Unrealized P&L: ${{ $value }} (threshold: -$1000)"
          
      - alert: TooManyOpenPositions
        expr: aibot_open_positions > 10
        for: 5m
        labels:
          severity: warning
          component: trading
        annotations:
          summary: "Too many open positions on {{ $labels.instance }}"
          description: "{{ $value }} positions open (threshold: 10)"
